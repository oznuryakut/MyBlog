<%- include('../partials/header') %>

<main class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">Kayıt Ol</h1>

    <% if (error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST">
      <div class="field">
        <label>Kullanıcı Adı</label>
        <input type="text" name="username" required placeholder="kullaniciadi">
      </div>
      <div class="field">
        <label>E-posta</label>
        <input type="email" name="email" required placeholder="ornek@mail.com">
      </div>
      <div class="field">
        <label>Şifre</label>
        <input type="password" name="password" required placeholder="En az 6 karakter">
      </div>
      <button type="submit" class="btn-submit">Kayıt Ol</button>
    </form>

    <p class="auth-switch">Zaten hesabın var mı? <a href="/auth/login">Giriş yap</a></p>
  </div>
</main>

<%- include('../partials/footer') %>