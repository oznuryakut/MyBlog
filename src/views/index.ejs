<%- include('partials/header') %>

<div class="hero-banner">
  <div class="hero-tag">Yazılım & Teknoloji</div>
</div>

<main class="container">

  <div class="feed">

    <% if (typeof activeCategory !== 'undefined') { %>
      <div class="feed-title-wrap">
        <div class="feed-label">Kategori</div>
        <h2 class="feed-title"><%= activeCategory.name %></h2>
      </div>
    <% } else if (typeof searchQuery !== 'undefined' && searchQuery) { %>
      <div class="feed-title-wrap">
        <div class="feed-label">Arama Sonuçları</div>
        <h2 class="feed-title">"<%= searchQuery %>"</h2>
      </div>
    <% } else { %>
      <div class="feed-label">Son Yazılar</div>
    <% } %>

    <% if (posts.length === 0) { %>
      <p class="empty">Henüz yazı yok.</p>
    <% } %>

    <% posts.forEach(post => { %>
      <article class="post-card">
        <div class="post-card-left">
          <div class="post-author">
            <div class="avatar"><%= post.author.username.charAt(0).toUpperCase() %></div>
            <span><%= post.author.username %></span>
          </div>
          <a href="/yazi/<%= post.slug %>" class="post-title"><%= post.title %></a>
          <p class="post-excerpt"><%= post.excerpt %></p>
          <div class="post-footer">
            <% if (post.category) { %>
              <a href="/kategori/<%= post.category.slug %>" class="post-tag"><%= post.category.name %></a>
            <% } %>
            <% if (post.tags && post.tags.length > 0) { %>
              <% post.tags.slice(0,2).forEach(tag => { %>
                <span class="post-tag" style="background:#f0f0f0;color:#555">#<%= tag %></span>
              <% }) %>
            <% } %>
            <span class="post-date"><%= new Date(post.createdAt).toLocaleDateString('tr-TR') %></span>
          </div>
        </div>
        <div class="post-thumb" style="width:140px;height:110px;">
          <% if (post.image) { %>
            <img src="<%= post.image %>" style="width:100%;height:100%;object-fit:contain;border-radius:8px;">
          <% } else { %>
            <span class="thumb-letter"><%= post.title.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
      </article>
    <% }) %>

  </div>

  <aside class="sidebar">
    <div class="sidebar-block">
      <h3>Kategoriler</h3>
      <ul class="category-list">
        <% if (categories.length === 0) { %>
          <li style="color:var(--muted);font-size:13px">Henüz kategori yok</li>
        <% } %>
        <% categories.forEach(cat => { %>
          <li>
            <a href="/kategori/<%= cat.slug %>"><%= cat.name %></a>
            <span class="arrow">→</span>
          </li>
        <% }) %>
      </ul>
    </div>

    <% if (!user) { %>
    <div class="sidebar-cta">
      <h3>Tartışmaya katıl</h3>
      <p>Yorum yapmak için üye ol</p>
      <a href="/auth/register">Üye Ol</a>
    </div>
    <% } %>
  </aside>

</main>

<%- include('partials/footer') %>
